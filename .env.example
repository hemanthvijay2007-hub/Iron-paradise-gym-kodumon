# ==============================================================================
# IRON PARADISE GYM KODUMON - ENVIRONMENT VARIABLES
# ==============================================================================
# In Vercel Project Settings -> Environment Variables, add these two keys:
#
# 1. VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# 2. VITE_SUPABASE_ANON_KEY: Your Supabase Project anon/public API key
#
# (Note: These keys are safe for frontend use as long as RLS is enabled.)
# ==============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
